/* Meridian — Analytics (with daily & weekly review) and Settings */
(function () {
  const M = window.M;
  const { html, useState, useEffect, useRef, Icon, PageHead, ItemRow, Empty, Bar, Seg, Ring } = M;
  const { addDays, today } = M;

  const Stat = ({ v, l, tone }) => html`<div class="card pad stat"><span class="v ${tone || ''}">${v}</span><span class="l">${l}</span></div>`;
  const doneOn = (d) => M.completedOn(d);
  const range = (from, n) => Array.from({ length: n }, (_, i) => addDays(from, i));
  const catMinutes = (days) => {
    const map = {}; days.forEach((d) => M.timedOn(d).forEach(({ ev }) => { const c = ev.source === 'local' ? M.ecat(ev.categoryId) : null; const k = c ? c.name : ev.source !== 'local' ? 'Imported' : 'Other'; map[k] = map[k] || { label: k, value: 0, color: c ? c.color : '#8B8D98' }; map[k].value += M.mins(ev.end) - M.mins(ev.start); }));
    return Object.values(map).sort((a, b) => b.value - a.value);
  };

  function Daily() {
    const T = today(), d = M.ui.reviewDate || T, st = M.dayStats(d), items = M.dayItems(d), comp = doneOn(d), open = items.filter((i) => i.status !== 'done');
    const hw = items.filter((i) => i.kind === 'homework'); const soon = M.open_().filter((i) => i.due && i.due > d && i.due <= addDays(d, 3)).sort(M.itemCmp('due'));
    const go = (x) => { M.ui.reviewDate = x; M.emit(); }; const cats = catMinutes([d]);
    return html`<div class="col g16"><div class="row wrap"><${M.DateNav} onPrev=${() => go(addDays(d, -1))} onNext=${() => go(addDays(d, 1))} onToday=${() => go(T)} label=${M.fmtDate(d, 'long')}/><span class="grow"></span>
        ${open.length > 0 && d <= T && html`<button class="btn soft" onClick=${() => { const to = d < T ? T : addDays(T, 1); const n = M.carryOver(d, to); M.toast(`Carried ${n} unfinished ${n === 1 ? 'item' : 'items'} to ${M.relDate(to).toLowerCase()}.`); }}><${Icon} n="arrowR" s=${14}/>Carry ${open.length} unfinished to ${d < T ? 'today' : 'tomorrow'}</button>`}</div>
      <div class="stats"><${Stat} v=${comp.length} l="tasks completed"/><${Stat} v=${open.length} l="remaining" tone=${open.length && d < T ? 'warn-t' : ''}/><${Stat} v=${st.pct + '%'} l="daily completion"/><${Stat} v=${M.fmtDur(st.focus)} l="focus time"/><${Stat} v=${M.fmtDur(st.scheduled)} l="scheduled"/></div>
      <div class="grid2">
        <div class="card pad"><div class="card-t mb12">Scheduled vs. actual focus</div><div class="hrow"><span>Scheduled</span><${Bar} pct=${st.scheduled ? 100 : 0} cls="thick" color="var(--line2)"/><b>${M.fmtDur(st.scheduled)}</b></div><div class="hrow"><span>Focused</span><${Bar} pct=${st.scheduled ? (st.focus / st.scheduled) * 100 : st.focus ? 100 : 0} cls="thick"/><b>${M.fmtDur(st.focus)}</b></div>
          <div class="xs dim mt8">Focus time comes from timer sessions. Start one from any task to track it.</div>
          ${cats.length > 0 && html`<div class="up mt16 mb8">Where the day went</div>${cats.map((c) => html`<div class="hrow"><span class="trunc"><i class="dot" style=${`--c:${c.color};margin-right:6px`}></i>${c.label}</span><${Bar} pct=${(c.value / cats[0].value) * 100} color=${c.color}/><span class="muted">${M.fmtDur(c.value)}</span></div>`)}`}</div>
        <div class="card pad"><div class="card-t mb12">Homework progress</div>${hw.length === 0 ? html`<div class="sm dim">No homework was planned or due this day.</div>` : hw.map((i) => { const p = M.progress(i); return html`<div class="mb12" style="cursor:pointer" onClick=${() => M.open('item', { id: i.id })}><div class="row between sm mb8"><span class="med trunc">${i.title}</span><span class="muted nowrap">${i.status === 'done' ? 'Done' : p.total ? `${p.done}/${p.total} steps` : i.status === 'doing' ? 'In progress' : 'Not started'}</span></div><${Bar} pct=${Math.round(M.frac(i) * 100)} color=${M.itemColor(i)}/></div>`; })}</div>
        <div class="card pad"><div class="card-h"><span class="card-t ok-t">Completed</span><span class="pill">${comp.length}</span></div>${comp.length ? html`<div class="list">${comp.map((it) => html`<${ItemRow} it=${it} key=${it.id}/>`)}</div>` : html`<div class="sm dim">Nothing completed on this day.</div>`}</div>
        <div class="card pad"><div class="card-h"><span class="card-t">Unfinished</span><span class="pill">${open.length}</span></div>${open.length ? html`<div class="list">${open.map((it) => html`<${ItemRow} it=${it} key=${it.id}/>`)}</div>` : html`<div class="sm dim">Everything planned for this day is done.</div>`}</div>
      </div>
      <div class="card pad"><div class="card-h"><span class="card-t">Coming up in the next 3 days</span><span class="pill">${soon.length}</span></div>${soon.length ? html`<div class="list">${soon.map((it) => html`<${ItemRow} it=${it} key=${it.id}/>`)}</div>` : html`<div class="sm dim">No deadlines in the next 3 days.</div>`}</div></div>`;
  }

  function Weekly() {
    const [ws, setWs] = useState(M.weekStart(today())); const T = today(), days = range(ws, 7), we = days[6], s = M.state;
    const per = days.map((d) => ({ d, done: doneOn(d).length, focus: M.focusMinOn(d), sched: M.scheduledMin(d) })); const total = per.reduce((n, x) => n + x.done, 0);
    const best = per.reduce((a, b) => (b.done > a.done ? b : a), per[0]);
    const hwDue = M.live().filter((i) => i.kind === 'homework' && i.due >= ws && i.due <= we), hwDone = hwDue.filter((i) => i.status === 'done');
    const submitted = s.items.filter((i) => i.kind === 'homework' && i.completedAt && M.ds(new Date(i.completedAt)) >= ws && M.ds(new Date(i.completedAt)) <= we);
    const missed = M.live().filter((i) => i.due >= ws && i.due <= we && ((i.status !== 'done' && M.isOverdue(i)) || (i.status === 'done' && i.completedAt > M.dueTs(i))));
    const cats = catMinutes(days), goals = s.goals.filter((g) => g.done && g.doneAt && M.ds(new Date(g.doneAt)) >= ws && M.ds(new Date(g.doneAt)) <= we);
    const next = M.open_().filter((i) => i.due > we && i.due <= addDays(we, 7)).sort(M.itemCmp('due'));
    const prev = range(addDays(ws, -7), 7).reduce((n, d) => n + doneOn(d).length, 0);
    return html`<div class="col g16"><div class="row wrap"><${M.DateNav} onPrev=${() => setWs(addDays(ws, -7))} onNext=${() => setWs(addDays(ws, 7))} onToday=${() => setWs(M.weekStart(T))} label=${`${M.fmtDate(ws, 'short')} – ${M.fmtDate(we, 'short')}`}/></div>
      <div class="stats"><${Stat} v=${total} l=${`tasks completed${prev ? ` (${total >= prev ? '+' : ''}${total - prev} vs. last week)` : ''}`}/><${Stat} v=${submitted.length} l="assignments finished"/><${Stat} v=${hwDue.length ? Math.round((hwDone.length / hwDue.length) * 100) + '%' : '—'} l="of homework due this week done"/><${Stat} v=${M.fmtDur(per.reduce((n, x) => n + x.focus, 0))} l="focus time"/><${Stat} v=${missed.length} l="missed deadlines" tone=${missed.length ? 'danger-t' : ''}/><${Stat} v=${goals.length} l="goals achieved"/></div>
      <div class="grid2">
        <div class="card pad"><div class="card-h"><span class="card-t">Tasks completed each day</span><span class="grow"></span>${total > 0 && html`<span class="sm muted">Most productive: <b>${M.DOW[M.dow(best.d)]}</b></span>`}</div><${M.Bars} data=${per.map((x) => ({ label: M.DOWS[M.dow(x.d)], value: x.done, dim: x.d > T }))} h=${150}/></div>
        <div class="card pad"><div class="card-h"><span class="card-t">Scheduled vs. focused time</span><span class="grow"></span><div class="legend"><span><i class="dot" style="--c:var(--line2)"></i>Scheduled</span><span><i class="dot" style="--c:var(--accent)"></i>Focused</span></div></div><${M.Bars} data=${per.map((x) => ({ label: M.DOWS[M.dow(x.d)], values: [x.sched, x.focus], colors: ['var(--line2)', 'var(--accent)'], titles: ['Scheduled', 'Focused'] }))} h=${150} fmt=${(v) => M.fmtDur(v)} showVal=${false}/></div>
        <div class="card pad"><div class="card-t mb12">Time allocation by category</div>${cats.length === 0 ? html`<div class="sm dim">Nothing was scheduled this week.</div>` : html`<div class="row g24 wrap"><${M.Donut} parts=${cats}><div><div class="serif" style="font-size:22px;line-height:1">${M.fmtDur(cats.reduce((n, c) => n + c.value, 0))}</div><div class="xxs dim">scheduled</div></div><//><div class="grow" style="min-width:160px"><${M.Legend} parts=${cats} fmt=${(v) => M.fmtDur(v)}/></div></div>`}</div>
        <div class="card pad"><div class="card-h"><span class="card-t">Missed deadlines</span><span class="pill ${missed.length ? 'danger' : ''}">${missed.length}</span></div>${missed.length ? html`<div class="list">${missed.map((it) => html`<${ItemRow} it=${it} key=${it.id}/>`)}</div>` : html`<div class="sm dim">No missed deadlines this week.</div>`}</div>
        <div class="card pad"><div class="card-h"><span class="card-t">Due next week</span><span class="pill">${next.length}</span></div>${next.length ? html`<div class="list">${next.slice(0, 8).map((it) => html`<${ItemRow} it=${it} key=${it.id}/>`)}</div>` : html`<div class="sm dim">Nothing due next week yet.</div>`}</div>
        <div class="card pad"><div class="card-t mb12">Goals achieved</div>${goals.length ? goals.map((g) => html`<div class="mini-row"><${Icon} n="checkCircle" s=${15} c="ok-t"/><span class="grow">${g.title}</span></div>`) : html`<div class="sm dim">No goals were marked achieved this week. ${s.goals.filter((g) => !g.done).length} still in progress.</div>`}</div>
      </div></div>`;
  }

  function Monthly() {
    const [m, setM] = useState(today().slice(0, 8) + '01'); const T = today(), s = M.state, n = new Date(M.pd(m).getFullYear(), M.pd(m).getMonth() + 1, 0).getDate(), days = range(m, n), end = days[n - 1];
    const trend = days.map((d) => ({ label: String(M.pd(d).getDate()), value: d > T ? 0 : doneOn(d).length })); const total = trend.reduce((a, b) => a + b.value, 0);
    const habits = s.habits.filter((h) => !h.archived).map((h) => { let due = 0, done = 0; days.forEach((d) => { if (d > T || d < (h.start || '0')) return; if (h.freq === 'weekly') { due += (h.perWeek || 1) / 7; } else if (M.habitDue(h, d)) due++; if (h.log[d]) done++; }); return { h, pct: due ? M.clamp(Math.round((done / due) * 100), 0, 100) : 0, done }; });
    const hw = M.live().filter((i) => i.kind === 'homework' && i.due >= m && i.due <= end);
    const weeks = []; for (let d = M.weekStart(m); d <= end; d = addDays(d, 7)) { const we = addDays(d, 6); weeks.push({ label: M.fmtDate(d < m ? m : d, 'short'), value: hw.filter((i) => i.due >= d && i.due <= we).length }); }
    const byClass = s.classes.map((c) => ({ label: c.name, color: c.color, value: hw.filter((i) => i.classId === c.id).length })).filter((x) => x.value); const unc = hw.filter((i) => !M.cls(i.classId)).length; if (unc) byClass.push({ label: 'No class', color: '#8B8D98', value: unc });
    const goals = s.goals, gDone = goals.filter((g) => g.done).length, gAvg = goals.length ? Math.round(goals.reduce((a, g) => a + M.goalProgress(g), 0) / goals.length) : 0;
    return html`<div class="col g16"><div class="row wrap"><${M.DateNav} onPrev=${() => setM(M.addMonths(m, -1))} onNext=${() => setM(M.addMonths(m, 1))} onToday=${() => setM(T.slice(0, 8) + '01')} label=${`${M.MON[M.pd(m).getMonth()]} ${M.pd(m).getFullYear()}`}/></div>
      <div class="stats"><${Stat} v=${total} l="tasks completed"/><${Stat} v=${hw.length} l="assignments due"/><${Stat} v=${hw.length ? Math.round((hw.filter((i) => i.status === 'done').length / hw.length) * 100) + '%' : '—'} l="assignments completed"/><${Stat} v=${M.fmtDur(days.reduce((a, d) => a + M.focusMinOn(d), 0))} l="focus time"/><${Stat} v=${`${gDone}/${goals.length}`} l="goals achieved"/></div>
      <div class="card pad"><div class="card-h"><span class="card-t">Productivity trend</span><span class="grow"></span><span class="sm muted">Tasks completed per day</span></div>${total === 0 ? html`<${Empty} sm title="No completed tasks this month yet"/>` : html`<${M.Area} data=${trend} h=${150}/>`}</div>
      <div class="grid2">
        <div class="card pad"><div class="card-t mb12">Habit consistency</div>${habits.length === 0 ? html`<div class="sm dim">No habits tracked. Start one in Goals → Habits.</div>` : habits.map(({ h, pct, done }) => html`<div class="hrow" style="grid-template-columns:150px 1fr 70px"><span class="trunc">${h.icon} ${h.name}</span><${Bar} pct=${pct} color=${h.color}/><span class="muted" style="text-align:right">${pct}% · ${done}d</span></div>`)}</div>
        <div class="card pad"><div class="card-t mb12">Project progress</div>${s.projects.length === 0 ? html`<div class="sm dim">No projects yet.</div>` : s.projects.map((p) => { const pr = M.projectProgress(p); return html`<div class="hrow" style="grid-template-columns:150px 1fr 44px;cursor:pointer" onClick=${() => M.go('projects', p.id)}><span class="trunc">${p.title}</span><${Bar} pct=${pr.pct} color=${p.color}/><b style="text-align:right">${pr.pct}%</b></div>`; })}</div>
        <div class="card pad"><div class="card-t mb12">Academic workload</div>${hw.length === 0 ? html`<div class="sm dim">No assignments due this month.</div>` : html`<${M.Bars} data=${weeks} h=${120}/><div class="xs dim mt8 mb12">Assignments due per week</div>${byClass.length > 0 && html`<div class="row g24 wrap"><${M.Donut} parts=${byClass} size=${104} stroke=${13}><b>${hw.length}</b><//><div class="grow" style="min-width:150px"><${M.Legend} parts=${byClass}/></div></div>`}`}</div>
        <div class="card pad"><div class="card-t mb12">Goal completion</div>${goals.length === 0 ? html`<div class="sm dim">No goals set.</div>` : html`<div class="row g24"><${Ring} pct=${gAvg} size=${96}><div><b style="font-size:18px">${gAvg}%</b><div class="xxs dim">average</div></div><//><div class="grow col g6">${goals.slice(0, 6).map((g) => html`<div class="row sm"><span class="grow trunc" style=${g.done ? 'color:var(--text3);text-decoration:line-through' : ''}>${g.title}</span><span class="muted">${M.goalProgress(g)}%</span></div>`)}</div></div>`}</div>
      </div></div>`;
  }

  M.views.analytics = function Analytics() {
    const tab = M.vs('anTab', 'daily');
    return html`<div class="page"><${PageHead} title="Analytics" sub="A calm look at how your time and work are going — no scores, no competition."><${Seg} value=${tab} onChange=${(v) => M.setVs('anTab', v)} options=${[['daily', 'Daily review'], ['weekly', 'Weekly review'], ['monthly', 'Monthly']]}/><//>
      ${tab === 'daily' && html`<${Daily}/>`}${tab === 'weekly' && html`<${Weekly}/>`}${tab === 'monthly' && html`<${Monthly}/>`}</div>`;
  };

  /* ---------- Settings ---------- */
  const Row = ({ t, d, children }) => html`<div class="set-row"><div class="grow"><b>${t}</b>${d && html`<span>${d}</span>`}</div>${children}</div>`;
  const ACCENTS = [['#5E6AD2', 'Iris'], ['#2F80ED', 'Ocean'], ['#0E9F8E', 'Teal'], ['#3A8F5C', 'Forest'], ['#D98A1F', 'Amber'], ['#E5604C', 'Coral'], ['#D6497F', 'Rose'], ['#8E5BD9', 'Violet'], ['#4B5563', 'Graphite']];

  function CatEditor({ k, title, note }) {
    const s = M.state, list = s[k];
    return html`<div class="card pad"><div class="card-h"><span class="card-t">${title}</span><span class="grow"></span><button class="btn sm" onClick=${() => M.ask({ title: 'New category', label: 'Name', onSave: (v) => { if (list.some((c) => c.name.toLowerCase() === v.toLowerCase())) return M.toast('That category already exists.'); M.act(() => list.push({ id: M.uid(), name: v, color: M.PALETTE[list.length % M.PALETTE.length] })); } })}><${Icon} n="plus" s=${13}/>Add</button></div>
      ${note && html`<div class="sm muted mb8">${note}</div>`}
      ${list.map((c) => html`<div class="row mb8" key=${c.id}><input type="color" aria-label=${'Color for ' + c.name} value=${c.color} onChange=${(e) => M.act(() => (c.color = e.target.value))}/><input class="inp" aria-label="Category name" value=${c.name} onInput=${(e) => M.act(() => (c.name = e.target.value))} onBlur=${(e) => { if (!e.target.value.trim()) M.act(() => (c.name = 'Untitled')); }}/>
        <button class="ibtn" aria-label=${'Delete ' + c.name} disabled=${list.length <= 1} onClick=${() => M.del(`category “${c.name}”`, (st) => { st[k] = st[k].filter((x) => x.id !== c.id); if (k === 'categories') st.items.forEach((i) => { if (i.categoryId === c.id) i.categoryId = null; }); else st.events.forEach((e) => { if (e.categoryId === c.id) e.categoryId = st[k][0].id; }); }, k === 'categories' ? 'Tasks in it become uncategorized.' : 'Its events move to the first remaining category.')}><${Icon} n="trash" s=${15}/></button></div>`)}</div>`;
  }

  function DataTab() {
    const s = M.state, [backups, setBackups] = useState(null), [busy, setBusy] = useState(false); const imp = useRef(), ics = useRef(), icsFor = useRef(null);
    const refresh = () => M.listBackups().then(setBackups).catch(() => setBackups([])); useEffect(() => { refresh(); }, []);
    const run = async (fn, ok) => { setBusy(true); try { await fn(); ok && M.toast(ok); } catch (e) { M.toast(e.message || 'Something went wrong.', { kind: 'error' }); } setBusy(false); refresh(); };
    const onImport = async (e) => { const f = e.target.files[0]; e.target.value = ''; if (!f) return; let o; try { o = JSON.parse(await f.text()); } catch (x) { return M.toast('That file is not valid JSON.', { kind: 'error' }); }
      if (!M.validImport(o)) return M.toast('That file is not a Meridian backup.', { kind: 'error' });
      if (!(await M.confirm({ title: 'Replace everything with this backup?', body: `Exported ${new Date(o.exportedAt).toLocaleString()}\n${o.state.items.length} tasks & assignments · ${o.state.events.length} events · ${(o.state.notes || []).length} notes\n\nYour current data will be replaced.${M.DB.db ? ' A safety backup of the current data is saved first.' : ''}`, danger: true, confirmLabel: 'Replace my data' }))) return;
      run(() => M.importData(o), 'Backup restored.'); };
    const onICS = async (e) => { const f = e.target.files[0]; e.target.value = ''; if (!f) return; try { const r = M.importICS(await f.text(), icsFor.current ? null : f.name.replace(/\.ics$/i, ''), icsFor.current); M.toast(`Calendar imported: ${r.added} new, ${r.updated} updated — no duplicates created.`); } catch (x) { M.toast(x.message, { kind: 'error' }); } icsFor.current = null; };
    const stamp = () => M.today();
    return html`<div class="col g16">
      <div class="card pad"><div class="card-t mb8">Storage</div>
        <${Row} t="Where your data lives" d=${M.storage === 'indexeddb' ? 'In this browser’s IndexedDB database on this device, with a second copy in local storage. Nothing is sent to a server.' : 'IndexedDB is blocked, so Meridian is using local storage only. Attachments and automatic backups are unavailable — export regularly.'}><span class="pill ${M.saveStatus === 'error' ? 'danger' : 'ok'}">${M.saveStatus === 'error' ? 'Save failed' : 'Auto-saving'}</span><//>
        <${Row} t="Contents" d=${`${s.items.length} tasks & assignments · ${s.events.length} events · ${s.notes.length} notes · ${s.projects.length} projects · ${s.reminders.length} reminders · ${s.habits.length} habits`}><span class="xs muted nowrap">${s._savedAt ? 'Saved ' + M.ago(s._savedAt) : ''}</span><//>
        <div class="note-box mt8"><${Icon} n="info" s=${15}/><div>Your data is tied to this browser and this address. Clearing site data, using a different browser, or opening Meridian from a different location starts with an empty app — use Export to move or protect your data.</div></div></div>
      <div class="card pad"><div class="card-t mb8">Export & import</div>
        <${Row} t="Export everything" d="Download one file with all your data, settings and attachments."><button class="btn" disabled=${busy} onClick=${() => run(async () => M.download(`meridian-backup-${stamp()}.json`, await M.exportData()), 'Backup file downloaded.')}><${Icon} n="download" s=${14}/>Export</button><//>
        <${Row} t="Import a backup file" d="Replace the current data with a previously exported file."><button class="btn" disabled=${busy} onClick=${() => imp.current.click()}><${Icon} n="upload" s=${14}/>Import</button><input type="file" accept=".json,application/json" hidden ref=${imp} onChange=${onImport}/><//></div>
      <div class="card pad"><div class="card-h"><span class="card-t">Backups on this device</span><span class="grow"></span><button class="btn sm" disabled=${busy || !M.DB.db} onClick=${() => run(() => M.backup('Manual backup', false), 'Backup created.')}><${Icon} n="plus" s=${13}/>Back up now</button></div>
        <div class="sm muted mb8">Meridian keeps an automatic snapshot for each day you use it (the last 14), plus any you create. Restore one to roll back.</div>
        ${!M.DB.db ? html`<div class="note-box warn"><${Icon} n="alert" s=${15}/>On-device backups need IndexedDB, which this browser is blocking. Use Export instead.</div>` : backups == null ? html`<div class="sm dim">Loading…</div>` : backups.length === 0 ? html`<div class="sm dim">No backups yet — one is created automatically once you have data.</div>` :
          backups.map((b) => html`<div class="set-row" key=${b.key}><div class="grow"><b>${b.label}</b><span>${new Date(b.at).toLocaleString()} · ${(b.size / 1024).toFixed(0)} KB</span></div>
            <button class="btn sm" disabled=${busy} onClick=${async () => { if (await M.confirm({ title: 'Restore this backup?', body: `${b.label} — ${new Date(b.at).toLocaleString()}\n\nYour current data will be replaced with this snapshot. A safety backup of the current state is saved first.`, confirmLabel: 'Restore', danger: true })) run(async () => { await M.backup('Before restore', false); await M.restoreBackup(b.key); }, 'Backup restored.'); }}><${Icon} n="undo" s=${13}/>Restore</button>
            <button class="ibtn sm" aria-label="Delete backup" onClick=${async () => { if (await M.confirm({ title: 'Delete this backup?', body: 'This snapshot will be permanently removed.', danger: true, confirmLabel: 'Delete' })) run(() => M.DB.del('backups', b.key)); }}><${Icon} n="trash" s=${14}/></button></div>`)}</div>
      <div class="card pad"><div class="card-h"><span class="card-t">Calendars</span><span class="grow"></span><button class="btn sm" onClick=${() => { icsFor.current = null; ics.current.click(); }}><${Icon} n="upload" s=${13}/>Import .ics</button><button class="btn sm" disabled=${!s.events.some((e) => e.source === 'local')} onClick=${() => { M.download(`meridian-calendar-${stamp()}.ics`, M.exportICS(), 'text/calendar'); M.toast('Calendar exported.'); }}><${Icon} n="download" s=${13}/>Export .ics</button><input type="file" accept=".ics,text/calendar" hidden ref=${ics} onChange=${onICS}/></div>
        <div class="note-box mb12"><${Icon} n="info" s=${15}/><div><b>Google Calendar:</b> live two-way sync needs a Google sign-in through a registered online service, which a private, local app like this can’t provide. Instead, export from Google Calendar (Settings → Import & export → Export) and import the .ics file here. Imported events are shown striped with ↗ so you can tell them apart, and re-importing the same calendar updates events in place without creating duplicates. To send Meridian events to Google, use Export .ics and import that file there.</div></div>
        ${s.calendars.length === 0 ? html`<div class="sm dim">No imported calendars.</div>` : s.calendars.map((c) => html`<div class="set-row" key=${c.id}><input type="color" aria-label="Calendar color" value=${c.color} onChange=${(e) => M.act((st) => { c.color = e.target.value; st.events.forEach((x) => { if (x.calId === c.id) x.color = c.color; }); })}/><div class="grow"><b>${c.name} ↗</b><span>${s.events.filter((e) => e.calId === c.id).length} events · last imported ${M.ago(c.syncedAt)}</span></div>
          <button class="btn sm" onClick=${() => { icsFor.current = c.id; ics.current.click(); }}><${Icon} n="refresh" s=${13}/>Re-import</button>
          <button class="ibtn sm" aria-label="Remove calendar" onClick=${() => M.del(`calendar “${c.name}”`, (st) => { st.events = st.events.filter((e) => e.calId !== c.id); st.calendars = st.calendars.filter((x) => x.id !== c.id); }, 'All events imported from it are removed. Events you created in Meridian are not affected.')}><${Icon} n="trash" s=${14}/></button></div>`)}</div>
      <div class="card pad" style="border-color:color-mix(in srgb,var(--danger) 35%,var(--line))"><div class="card-t danger-t mb8">Danger zone</div>
        <${Row} t="Erase all data" d="Remove every task, event, note and setting and start fresh."><button class="btn danger" onClick=${async () => { if (!(await M.confirm({ title: 'Erase all data?', body: 'This removes everything in Meridian on this device: tasks, homework, schedule, notes, goals, habits and settings.' + (M.DB.db ? '\n\nA final backup is saved first, so you can still restore it from the app afterwards.' : '\n\nThis cannot be undone — export a backup first.'), danger: true, confirmLabel: 'Erase everything' }))) return; run(async () => { if (M.DB.db && M.hasData()) await M.backup('Before erasing all data', false); M.replaceState({}); M.go('dashboard'); M.open('welcome'); }, 'All data erased.'); }}>Erase…</button><//></div>
    </div>`;
  }

  function WeatherCard() {
    const W = M.state.settings.weather, [q, setQ] = useState(''), [res, setRes] = useState(null), [busy, setBusy] = useState(false); const setW = (p) => M.act((s) => Object.assign(s.settings.weather, p));
    const search = async (e) => { e.preventDefault(); if (!q.trim()) return; setBusy(true); try { setRes(await M.geocode(q.trim())); } catch (x) { M.toast('Could not search for that place. Check your connection.', { kind: 'error' }); } setBusy(false); };
    return html`<div class="card pad"><div class="card-t mb8">Weather</div>
      <${Row} t="Show weather on the dashboard" d="Uses the free Open-Meteo service. Only the location you choose is sent — no account or key."><${M.Switch} on=${W.on} onChange=${(v) => setW({ on: v })}/><//>
      ${W.on && html`<${Row} t="Location" d=${W.label || 'Not set — search for your city below.'}><${Seg} value=${W.unit} options=${[['F', '°F'], ['C', '°C']]} onChange=${(v) => setW({ unit: v })}/><//>
        <form class="row mt8" onSubmit=${search}><input class="inp" placeholder="Search city…" aria-label="City" value=${q} onInput=${(e) => setQ(e.target.value)}/><button class="btn" disabled=${busy || !q.trim()}>${busy ? 'Searching…' : 'Search'}</button></form>
        ${res && (res.length === 0 ? html`<div class="sm dim mt8">No places found.</div>` : html`<div class="col g2 mt8">${res.map((r) => html`<button class="menu-item" onClick=${() => { setW({ label: r.label, lat: r.lat, lon: r.lon }); setRes(null); setQ(''); M.toast(`Weather set to ${r.label}.`); }}><${Icon} n="mapPin" s=${14}/><span>${r.label}</span></button>`)}</div>`)}`}</div>`;
  }

  M.views.settings = function Settings() {
    const s = M.state, S = s.settings, tab = M.vs('setTab', 'appearance'); const set = (k, v) => M.act((st) => (st.settings[k] = v));
    const move = (arr, i, dir) => M.act(() => { const j = i + dir; if (j < 0 || j >= arr.length) return; [arr[i], arr[j]] = [arr[j], arr[i]]; });
    const hours = Array.from({ length: 25 }, (_, i) => i); const hl = (h) => (h === 24 ? 'Midnight' : M.fmtTime(M.pad(h) + ':00'));
    const tabs = [['appearance', 'Appearance', 'sun'], ['layout', 'Dashboard & sidebar', 'grid'], ['calendar', 'Calendar & schedule', 'calendar'], ['categories', 'Categories', 'tag'], ['tasks', 'Tasks & focus', 'checkCircle'], ['notifications', 'Notifications', 'bell'], ['data', 'Data & backup', 'download'], ['about', 'Shortcuts & about', 'info']];
    const timeIn = (k) => html`<input class="inp sm" type="time" style="width:116px" aria-label=${k} value=${S[k]} onInput=${(e) => e.target.value && set(k, e.target.value)}/>`;
    return html`<div class="page"><${PageHead} title="Settings" sub="Everything here saves automatically."/>
      <div class="split side-l"><nav class="side-nav" aria-label="Settings sections">${tabs.map(([k, l, ic]) => html`<button class=${tab === k ? 'on' : ''} onClick=${() => M.setVs('setTab', k)}><${Icon} n=${ic} s=${15}/>${l}</button>`)}</nav>
      <div class="col g16" style="min-width:0">
        ${tab === 'appearance' && html`<div class="card pad"><div class="card-t mb8">Profile</div><${Row} t="Your name" d="Used for the dashboard greeting."><input class="inp" style="width:200px" aria-label="Your name" value=${S.name} onInput=${(e) => set('name', e.target.value)}/><//></div>
          <div class="card pad"><div class="card-t mb8">Theme</div>
            <${Row} t="Mode" d="Auto follows your device."><${Seg} value=${S.theme} options=${[['auto', 'Auto'], ['light', 'Light', 'sun'], ['dark', 'Dark', 'moon']]} onChange=${(v) => set('theme', v)}/><//>
            <${Row} t="Accent color" d=${(ACCENTS.find((a) => a[0] === S.accent) || ['', 'Custom'])[1]}><${M.Swatches} value=${S.accent} colors=${ACCENTS.map((a) => a[0])} onChange=${(c) => set('accent', c)}/><//>
            <${Row} t="Background tone" d="The overall temperature of the interface."><${Seg} value=${S.tone} options=${[['neutral', 'Neutral'], ['warm', 'Warm'], ['cool', 'Cool']]} onChange=${(v) => set('tone', v)}/><//>
            <${Row} t="Density" d="Compact fits more on screen."><${Seg} value=${S.density} options=${[['comfortable', 'Comfortable'], ['compact', 'Compact']]} onChange=${(v) => set('density', v)}/><//></div>
          <${WeatherCard}/>`}
        ${tab === 'layout' && html`<div class="card pad"><div class="card-t mb8">Dashboard widgets</div><div class="sm muted mb8">Choose what appears on the dashboard, its order and its width. You can also use “Customize” on the dashboard itself.</div>
            ${S.dashboard.map((w, i) => html`<div class="set-row" style="padding:8px 0" key=${w.id}><div class="grow"><b>${M.WIDGETS.find((x) => x.id === w.id).label}</b></div>
              <${Seg} value=${w.size} options=${[['third', 'S'], ['half', 'M'], ['full', 'L']]} onChange=${(v) => M.act(() => (w.size = v))}/>
              <button class="ibtn sm" aria-label="Move up" disabled=${i === 0} onClick=${() => move(S.dashboard, i, -1)}><${Icon} n="chevU" s=${14}/></button><button class="ibtn sm" aria-label="Move down" disabled=${i === S.dashboard.length - 1} onClick=${() => move(S.dashboard, i, 1)}><${Icon} n="chevD" s=${14}/></button>
              <${M.Switch} on=${w.on} onChange=${(v) => M.act(() => (w.on = v))}/></div>`)}</div>
          <div class="card pad"><div class="card-t mb8">Sidebar</div><div class="sm muted mb8">Reorder sections or hide the ones you don’t use. Hidden sections stay reachable from search (⌘K).</div>
            ${S.sidebar.map((x, i) => { const n = M.NAV.find((y) => y.id === x.id); return html`<div class="set-row" style="padding:8px 0" key=${x.id}><${Icon} n=${n.icon} s=${16} c="muted"/><div class="grow"><b>${n.label}</b></div>
              <button class="ibtn sm" aria-label="Move up" disabled=${i === 0} onClick=${() => move(S.sidebar, i, -1)}><${Icon} n="chevU" s=${14}/></button><button class="ibtn sm" aria-label="Move down" disabled=${i === S.sidebar.length - 1} onClick=${() => move(S.sidebar, i, 1)}><${Icon} n="chevD" s=${14}/></button>
              ${x.id === 'settings' || x.id === 'dashboard' ? html`<span class="xs dim" style="width:36px;text-align:center">Always</span>` : html`<${M.Switch} on=${x.on} onChange=${(v) => M.act(() => (x.on = v))}/>`}</div>`; })}
            <${Row} t="Collapse sidebar to icons" d="You can also toggle this from the sidebar itself."><${M.Switch} on=${S.sidebarCollapsed} onChange=${(v) => set('sidebarCollapsed', v)}/><//></div>`}
        ${tab === 'calendar' && html`<div class="card pad"><div class="card-t mb8">Calendar appearance</div>
            <${Row} t="Week starts on"><${Seg} value=${S.weekStart} options=${[[0, 'Sunday'], [1, 'Monday'], [6, 'Saturday']]} onChange=${(v) => set('weekStart', v)}/><//>
            <${Row} t="Time format"><${Seg} value=${S.time24} options=${[[false, '12-hour'], [true, '24-hour']]} onChange=${(v) => set('time24', v)}/><//>
            <${Row} t="Show weekends" d="In week and month views."><${M.Switch} on=${S.showWeekends} onChange=${(v) => set('showWeekends', v)}/><//>
            <${Row} t="Show deadlines on the calendar" d="Task, assignment and project due dates appear as dashed chips."><${M.Switch} on=${S.showDeadlines} onChange=${(v) => set('showDeadlines', v)}/><//></div>
          <div class="card pad"><div class="card-t mb8">Schedule display</div>
            <${Row} t="Visible hours" d="The timeline expands automatically if an event falls outside this range."><select class="inp sm" style="width:108px" aria-label="Day starts" value=${S.dayStart} onChange=${(e) => { const v = +e.target.value; M.act((st) => { st.settings.dayStart = v; if (st.settings.dayEnd <= v) st.settings.dayEnd = Math.min(24, v + 2); }); }}>${hours.slice(0, 23).map((h) => html`<option value=${h}>${hl(h)}</option>`)}</select><span class="muted">to</span>
              <select class="inp sm" style="width:108px" aria-label="Day ends" value=${S.dayEnd} onChange=${(e) => set('dayEnd', +e.target.value)}>${hours.filter((h) => h > S.dayStart + 1).map((h) => html`<option value=${h}>${hl(h)}</option>`)}</select><//>
            <${Row} t="Hour height"><${Seg} value=${S.slotH} options=${[[40, 'Compact'], [52, 'Comfortable'], [68, 'Spacious']]} onChange=${(v) => set('slotH', v)}/><//></div>
          <div class="card pad"><div class="card-t mb8">Smart scheduling</div><div class="sm muted mb8">When you ask Meridian to find time for an assignment, it only suggests slots inside these hours and around your existing events.</div>
            <${Row} t="Weekday study hours">${timeIn('studyStart')}<span class="muted">to</span>${timeIn('studyEnd')}<//>
            <${Row} t="Weekend study hours">${timeIn('weekendStart')}<span class="muted">to</span>${timeIn('weekendEnd')}<//>
            <${Row} t="Longest work block" d="Longer work is split into sessions with short breaks."><select class="inp sm" style="width:116px" aria-label="Session length" value=${S.sessionLen} onChange=${(e) => set('sessionLen', +e.target.value)}>${[25, 30, 45, 50, 60, 90, 120].map((m) => html`<option value=${m}>${M.fmtDur(m)}</option>`)}</select><//></div>`}
        ${tab === 'categories' && html`<${CatEditor} k="categories" title="Task categories" note="Used to organize tasks. Homework is organized by class instead."/><${CatEditor} k="eventCategories" title="Calendar & schedule colors" note="Each event category has its own color on the calendar."/>
          <div class="card pad"><div class="card-h"><span class="card-t">Classes</span><span class="grow"></span><button class="btn sm" onClick=${() => M.open('class')}><${Icon} n="plus" s=${13}/>Add</button></div>${s.classes.length === 0 ? html`<div class="sm dim">No classes yet.</div>` : s.classes.map((c) => html`<div class="set-row" style="padding:8px 0;cursor:pointer" onClick=${() => M.open('class', { id: c.id })}><div class="class-ic sm" style=${`--c:${c.color}`}>${c.icon}</div><div class="grow"><b>${c.name}</b></div><${Icon} n="edit" s=${14} c="dim"/></div>`)}</div>`}
        ${tab === 'tasks' && html`<div class="card pad"><div class="card-t mb8">Tasks</div>
            <${Row} t="Complete the parent when all steps are done" d="You can override this for an individual task or assignment in its details."><${M.Switch} on=${S.autoComplete} onChange=${(v) => set('autoComplete', v)}/><//>
            <${Row} t="Show homework in the Tasks section" d="Homework always appears in Homework, My Day and the calendar."><${M.Switch} on=${S.tasksShowHomework} onChange=${(v) => set('tasksShowHomework', v)}/><//></div>
          <div class="card pad"><div class="card-t mb8">Focus timer</div>${[['work', 'Focus length (minutes)', 1, 180], ['short', 'Short break (minutes)', 1, 60], ['long', 'Long break (minutes)', 1, 90], ['rounds', 'Rounds before a long break', 1, 12]].map(([k, l, a, b]) => html`<${Row} t=${l}><input class="inp sm" type="number" style="width:80px" min=${a} max=${b} aria-label=${l} value=${S.pomodoro[k]} onInput=${(e) => { const n = parseInt(e.target.value, 10); if (!isNaN(n)) M.act((st) => (st.settings.pomodoro[k] = M.clamp(n, a, b))); }}/><//>`)}
            <${Row} t="Auto-start next phase"><${M.Switch} on=${S.pomodoro.autoNext} onChange=${(v) => M.act((st) => (st.settings.pomodoro.autoNext = v))}/><//>
            <${Row} t="Motivational message in focus mode"><${M.Switch} on=${S.motivate} onChange=${(v) => set('motivate', v)}/><//></div>`}
        ${tab === 'notifications' && html`<div class="card pad"><div class="card-t mb8">Notifications</div><p class="sm muted mb12">Notification preferences, system-notification permission and a test alert live on the Reminders page, next to your reminders.</p><button class="btn primary" onClick=${() => M.go('reminders')}><${Icon} n="bell" s=${14}/>Open notification settings</button></div>`}
        ${tab === 'data' && html`<${DataTab}/>`}
        ${tab === 'about' && html`<div class="card pad"><div class="card-t mb8">Keyboard shortcuts</div>${[['⌘K / Ctrl K', 'Search everything & quick add'], ['N', 'New task'], ['H', 'New homework assignment'], ['E', 'New event'], ['R', 'New reminder'], ['C', 'Quick capture a note'], ['F', 'Open focus mode'], ['G then D / M / C / T / H', 'Go to Dashboard / My Day / Calendar / Tasks / Homework'], ['Esc', 'Close dialogs']].map(([k, d]) => html`<div class="set-row" style="padding:8px 0"><div class="grow"><b>${d}</b></div><span class="kbd">${k}</span></div>`)}</div>
          <div class="card pad"><div class="card-t mb8">Quick-add phrases</div><p class="sm muted">In ⌘K or any “add” box you can type naturally: <b>“Biology worksheet due Thursday, high priority”</b>, <b>“Dentist tomorrow 3-4pm”</b>, <b>“remind me to call mom at 6pm”</b>, <b>“Essay draft in 3 days #school”</b>. Mentioning a class name files it as homework for that class. Parsing happens on your device — no AI service is involved.</p></div>
          <div class="card pad"><div class="row g12"><div class="sb-logo"><${Icon} n="logo" s=${18}/></div><div><b class="serif" style="font-size:22px">Meridian</b><div class="xs muted">Version 1.0 · A private, local-first planner. Your data never leaves this device unless you export it.</div></div></div></div>`}
      </div></div></div>`;
  };
})();
